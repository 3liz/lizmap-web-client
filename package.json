{
  "name": "lizmap-web-client",
  "version": "3.9.12-pre",
  "description": "Lizmap Web Client",
  "license": "ISC",
  "author": "3Liz",
  "engines": {
    "node": ">=22.12.0"
  },
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "workspaces": [
    "assets",
    "tests/js-units",
    "tests/end2end"
  ],
  "scripts": {
    "build": "rspack build --config assets/webpack.prod.js",
    "bats": "bats ./tests/end2end/bats/",
    "js:test": "mocha --require ./tests/js-units/fixtures.js --recursive ./tests/js-units/node",
    "jsdoc": "make version-doc && make js-doc",
    "pr:open": "playwright test --config tests/end2end/playwright.config.ts --ui tests/end2end/",
    "test:e2e": "bash tests/end2end/run-all-tests.sh",
    "pretest-fix": "eslint -c eslint.config.mjs --fix",
    "pretest": "eslint -c eslint.config.mjs",
    "style-fix": "stylelint \"**/*.css\" --fix",
    "style-check": "stylelint \"**/*.css\"",
    "watch": "rspack --watch --config assets/webpack.dev.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.x",
    "@playwright/test": "^1.63.0",
    "@rspack/cli": "~2.2.x",
    "@rspack/core": "~2.2.x",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@turf/line-split": "^7.4.x",
    "bats": "^1.13.0",
    "bats-assert": "^2.2.4",
    "bats-support": "^0.3.0",
    "chai": "^6.3.0",
    "dompurify": "^3.4.x",
    "dotenv": "^18.0.2",
    "eslint-plugin-jsdoc": "^63.3.x",
    "flatgeobuf": "^4.4.x",
    "jsts": "^2.12.x",
    "lit-html": "^3.3.x",
    "mocha": "^12.0.3",
    "ol": "^10.10.x",
    "ol-ext": "^4.0.x",
    "ol-wfs-capabilities": "^2.0.x",
    "playwright-ctrf-json-reporter": "^0.1.0",
    "postcss-lit": "^1.4.x",
    "proj4": "^2.20.x",
    "shpjs": "^6.2.x",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.x",
    "undici": "^8.11.2",
    "webpack-merge": "^6.0.x",
    "xmldoc": "^3.0.0"
  }
}
